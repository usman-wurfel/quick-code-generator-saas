APP_NAME="Quick Code"
APP_SLOGAN="Design. Scan. Convert."
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL="http://127.0.0.1:8000"
APP_PORT=8000
APP_HOST=127.0.0.1
FORCE_HTTPS=false

MARKETPLACE=CUSTOM
FRONTEND_URL="http://127.0.0.1:8000"

SUPER_USER_NAME=admin
SUPER_USER_EMAIL="admin@gmail.com"
