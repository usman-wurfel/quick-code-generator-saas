EMAIL_VERIFICATION_AFTER_SIGN_UP=true
ENABLE_SMTP_TEST=false
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qr_code
